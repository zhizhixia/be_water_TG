# Telegram 凭据：仅填写专用测试账号；不要提交填好的 .env
API_ID=0
API_HASH=replace_with_your_api_hash
PHONE=replace_with_your_phone

# 仅列出已经取得管理员明确许可的群，逗号分隔。
# 留为占位值时启动校验会失败，不会连接真实服务。
TARGET_GROUPS=https://t.me/replace_with_authorized_group
# 旧版单群兼容项；新配置请保持为空，且不要与 TARGET_GROUPS 一起填写实际群。
TARGET_GROUP=

# 基础轮询间隔（秒）
MIN_INTERVAL=60
MAX_INTERVAL=180

# 可选代理；未同时配置主机与端口时保持禁用。
PROXY_HOST=
PROXY_PORT=
PROXY_TYPE=http

# 可选每群 TXT 兜底映射：群组|文件路径，多个条目用逗号分隔。
MESSAGE_FILES=

# AI：默认关闭。启用即表示操作者授权向 AI_BASE_URL 外发限定的文本上下文；密钥必须自行填写。
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_PROMPT=作为普通群友，根据最近对话简短、自然地参与；不要虚构身份或经历。
AI_CONTEXT_COUNT=5
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500
AI_TIMEOUT=30

# 运行窗口：默认关闭；启用时仅在下列窗口调度。
SCHEDULE_ENABLED=false
SCHEDULE_MORNING_START=08:00
SCHEDULE_MORNING_END=11:00
SCHEDULE_AFTERNOON_START=14:00
SCHEDULE_AFTERNOON_END=18:00

# 反检测参数：默认关闭；仅在取得平台和群管理员许可后评估是否启用。
ANTI_DETECT=false
TYPING_DELAY_MIN=3
TYPING_DELAY_MAX=8
THINKING_DELAY_MIN=5
THINKING_DELAY_MAX=25
SKIP_ROUND_PCT=10
GROUP_GAP_MIN=1
GROUP_GAP_MAX=1

# 授权群普通参与策略（全局生效）
DAILY_LIMIT=30
IDLE_THRESHOLD_MINUTES=10
QUESTION_REPLY_PCT=70
DISCUSSION_REPLY_PCT=15
REPLY_DELAY_MIN=20
REPLY_DELAY_MAX=90

# 本地持久化状态；state/ 和数据库文件不得提交。
STATE_DB_PATH=state/be_water.db

# 签到和抽奖：默认启用；仅限显式授权的 TARGET_GROUPS，操作者应在启用前完成授权确认。
LOTTERY_ENABLED=true
LOTTERY_SCAN_INTERVAL_MINUTES=60
DAILY_PINNED_LOTTERY_SCAN_ENABLED=true
DAILY_CHECKIN_ENABLED=true
LOTTERY_PER_GROUP_DAILY_LIMIT=10
LOTTERY_ACCOUNT_DAILY_LIMIT=30
LOTTERY_ACTION_GAP_MIN_SECONDS=20
LOTTERY_ACTION_GAP_MAX_SECONDS=60
